# Real DNS record must point at the VM before launch. No hostname has been reserved.
SITE_HOST=replace-with-your-real-hostname
LOGIN_USER=owner
# Generate interactively with scripts/configure.sh; never put a plain password here.
LOGIN_HASH=
# After successful deployment pin this to the verified multiarch manifest digest.
BROWSER_IMAGE=lscr.io/linuxserver/chromium:latest
